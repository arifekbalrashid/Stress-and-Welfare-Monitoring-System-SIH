# ============================================
# SAATHI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Database (defaults to local SQLite if not set)
# DATABASE_URL=sqlite:///saathi.db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Gemini AI (required for chat and AI-powered recommendations)
GEMINI_API_KEY=your-gemini-api-key-here
