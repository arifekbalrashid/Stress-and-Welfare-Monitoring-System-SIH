# ============================================
# SAATHI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Gemini AI (required for chat and AI-powered recommendations)
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=saathi

# Optional overrides (defaults are already set in config.py)
# JWT_SECRET_KEY=change-this-to-a-long-random-string
# BACKEND_CORS_ORIGINS=http://localhost:5173
